# Copy to .env and adjust. All vars are prefixed ANALYTICS_.

# ── Storage ───────────────────────────────────────────────────────────────
# Production: set MYSQL_* below (same as knowbot/chat-service, database `knowbot`).
# Local dev with no MySQL: leave MYSQL_HOST empty → SQLite fallback automatically.
#
# Optional override (tests / special cases only — do NOT set in normal prod):
#   ANALYTICS_DATABASE_URL=sqlite+aiosqlite:///./analytics.db

# MySQL connection (bare MYSQL_* names, no ANALYTICS_ prefix).
# Shares the `knowbot` database with chat-service; only table names differ.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=knowbot
MYSQL_POOL_SIZE=5
MYSQL_POOL_RECYCLE=3600

# Shared secret the agent sends as X-API-Key when POSTing telemetry.
# Leave empty to disable ingest auth (dev only).
ANALYTICS_INGEST_API_KEY=

# Separate key guarding the read/reporting endpoints. Empty = open.
ANALYTICS_QUERY_API_KEY=

# Optional pricing override: inline JSON or a path to a JSON file.
# ANALYTICS_PRICING_JSON=/etc/analytics/pricing.json
ANALYTICS_PRICING_JSON=

# Max records per batch POST.
ANALYTICS_MAX_BATCH_SIZE=1000

# CORS (comma-separated origins, or *).
ANALYTICS_CORS_ALLOW_ORIGINS=*
