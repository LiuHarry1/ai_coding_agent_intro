{
  "provider": {
    "provider": "openai",
    "baseURL": "http://localhost:4141/v1",
    "apiKey": "not-needed",
    "model": "gpt-5.4"
  },
  "compaction": {
    "tokenThreshold": 167000,
    "microCompactThreshold": 140000,
    "tailTokenBudget": 40000,
    "microCompactKeepRecent": 5,
    "model": "gpt-5.4"
  },
  "mcpServers": {

    "chrome-devtools": {
      "command": "npx",
      "args": ["-y", "chrome-devtools-mcp@latest"]
    },

    "mcp_server": {
      "command": "python",
      "args": ["-m", "mcp_server_fetch"]
    }
  },

  "disabledTools": ["web_fetch"]
}
