{
  "provider": {
    "provider": "anthropic",
    "baseURL": "http://localhost:4141/v1",
    "apiKey": "not-needed",
    "model": "claude-opus-4.6",
    "thinking": { "mode": "medium" }
  },
  "compaction": {
    "tokenThreshold": 167000,
    "microCompactThreshold": 140000,
    "tailTokenBudget": 40000,
    "microCompactKeepRecent": 5,
    "model": "claude-opus-4.6"
  },
  "mcpServers": {

    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "/tmp"]
    },

    "chrome-devtools": {
      "command": "npx",
      "args": ["-y", "chrome-devtools-mcp@latest"]
    },

    "mcp_server": {
      "command": "python",
      "args": ["-m", "mcp_server_fetch"]
    }
  },

  "disabledTools": ["web_fetch"]
}
