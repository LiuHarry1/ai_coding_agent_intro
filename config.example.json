{
  "provider": {
    "provider": "anthropic",
    "baseURL": "http://localhost:4141/v1",
    "apiKey": "not-needed",
    "model": "claude-opus-4.7",
    "thinking": { "mode": "medium" }
  },
  "compaction": {
    "threshold": 60,
    "keepRecent": 15,
    "model": "gpt-4o-mini"
  },
  "mcpServers": {

    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "/tmp"]
    },

    "chrome-devtools": {
      "command": "npx",
      "args": ["-y", "chrome-devtools-mcp@latest"]
    }
  }
}
