{
  "provider": {
    "name": "copilot-proxy",
    "baseURL": "http://localhost:4141/v1",
    "apiKey": "not-needed",
    "model": "gpt-5.2",
    "reasoningEffort": "medium"
  },
  "compaction": {
    "threshold": 60,
    "keepRecent": 15,
    "model": "gpt-4o-mini"
  },
  "mcpServers": {

    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "/tmp"]
    },

    "chrome-devtools": {
      "command": "npx",
      "args": ["-y", "chrome-devtools-mcp@latest"]
    }
  }
}
