{
  "manifest_version": 3,
  "name": "Baize Agent Browser Bridge",
  "version": "1.0.0",
  "description": "Lets the Baize coding agent drive tabs in this browser, so pages load with your real logged-in session.",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": ["debugger", "tabs", "tabGroups", "storage", "alarms", "downloads"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Baize Agent Browser Bridge"
  }
}
