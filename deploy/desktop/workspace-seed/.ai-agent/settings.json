{
  "models": {
    "large": {
      "provider": "openai-compatible",
      "baseURL": "http://localhost:4141/v1",
      "apiKey": "not-needed",
      "model": "gpt-5.4"
    },
    "medium": {
      "provider": "openai-compatible",
      "baseURL": "http://localhost:4141/v1",
      "apiKey": "not-needed",
      "model": "gpt-4.1"
    },
    "small": {
      "provider": "openai-compatible",
      "baseURL": "http://localhost:4141/v1",
      "apiKey": "sk-xxx",
      "model": "gpt-4o-mini"
    }
  },
  "compaction": {
    "enabled": true,
    "contextWindow": 200000,
    "microCompactKeepRecent": 5,
    "maxFilesToRestore": 5,
    "maxTokensPerFile": 5000,
    "fileBudget": 50000,
    "timeBasedMicroEnabled": true,
    "timeBasedMicroGapMinutes": 5
  },
  "sessionMemory": {
    "enabled": false,
    "minimumTokensToInit": 10000,
    "minimumTokensBetweenUpdate": 5000,
    "toolCallsBetweenUpdates": 3,
    "cacheSafe": true,
    "modelTier": "small",
    "compactMinTokens": 10000,
    "compactMaxTokens": 40000,
    "compactMinTextMessages": 5
  },
  "autoMemory": {
    "enabled": false,
    "prefetchEnabled": true,
    "cacheSafe": true,
    "modelTier": "small",
    "prefetchModelTier": "small"
  },
  "agents": {
    "picker": {
      "modes": [],
      "primaries": ["browser"]
    },
    "default": {
      "mode": "agent",
      "agentType": "browser"
    }
  },
  "browser": {
    "mode": "extension"
  },
  "mcpServers": {},
  "disabledTools": []
}
