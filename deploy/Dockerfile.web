# syntax=docker/dockerfile:1
#
# Frontend image: builds the Vite UI, then serves it (plus reverse-proxies
# the agent API) from nginx. Pair with deploy/Dockerfile.agent via
# deploy/docker-compose.yml.
#
# Build from repo root:
#   docker build -f deploy/Dockerfile.web -t ai-agent-web:latest .

FROM node:22-bookworm-slim AS build
WORKDIR /ui
COPY client/web/package.json client/web/package-lock.json ./
RUN npm ci
COPY client/web/ ./
RUN npm run build

FROM nginx:alpine
# `htpasswd` (apache2-utils) is used by the startup script to hash the
# optional Basic Auth password from the WEB_PASSWORD env var.
RUN apk add --no-cache apache2-utils
# Static assets live where nginx.conf points its `root` directive.
COPY --from=build /ui/dist /usr/share/nginx/html
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
# Startup hook: the stock nginx entrypoint runs *.sh in this dir before
# launching nginx. It (re)generates auth.inc from WEB_PASSWORD on every
# `docker run` / `compose up`, so the password is a RUNTIME setting — no
# rebuild needed to change it, and it never lands in `docker history`.
COPY deploy/web-auth.sh /docker-entrypoint.d/40-web-auth.sh
# Runtime SPA config (auth on/off) — regenerates app-config.js from
# AUTH_ENABLED so one image serves every deploy mode (password/local/SSO).
COPY deploy/web-runtime-config.sh /docker-entrypoint.d/45-web-runtime-config.sh
# SSO reverse-proxy block — generated from AUTH_SERVICE_URL so /sso and
# /api/auth forward to an external auth-service (empty when unset).
COPY deploy/web-auth-proxy.sh /docker-entrypoint.d/46-web-auth-proxy.sh
# Pre-create empty includes so `nginx -t` is valid before the hooks run,
# strip any CRLF (scripts may be authored on Windows), make them runnable.
RUN touch /etc/nginx/conf.d/auth.inc /etc/nginx/conf.d/auth-proxy.inc \
 && sed -i 's/\r$//' /docker-entrypoint.d/40-web-auth.sh /docker-entrypoint.d/45-web-runtime-config.sh /docker-entrypoint.d/46-web-auth-proxy.sh \
 && chmod +x /docker-entrypoint.d/40-web-auth.sh /docker-entrypoint.d/45-web-runtime-config.sh /docker-entrypoint.d/46-web-auth-proxy.sh

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD wget -q -O - http://127.0.0.1/healthz >/dev/null 2>&1 || exit 1
