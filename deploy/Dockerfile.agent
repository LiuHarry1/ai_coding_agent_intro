# syntax=docker/dockerfile:1
#
# Agent-only image. No frontend assets bundled — pair with deploy/Dockerfile.web
# (nginx + dist) via deploy/docker-compose.yml. If you instead want the
# all-in-one image (agent + UI served from Node), use the root Dockerfile.
#
# Build from repo root:
#   docker build -f deploy/Dockerfile.agent -t ai-agent:latest .

FROM node:22-bookworm-slim
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    git \
    python3 \
    python3-venv \
    python3-pip \
    python-is-python3 \
  && rm -rf /var/lib/apt/lists/*

# Python 3.11 + venv so the agent's bash tool can invoke python/pip
# without polluting the system site-packages.
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    VIRTUAL_ENV=/opt/venv
ENV PATH="${VIRTUAL_ENV}/bin:${PATH}"
COPY requirements.txt ./
RUN python3 -m venv "${VIRTUAL_ENV}" \
  && pip install --no-cache-dir --upgrade pip \
  && pip install --no-cache-dir -r requirements.txt

COPY package.json package-lock.json ./
# Runtime needs tsx to load TypeScript examples; keep prod deps lean.
RUN npm ci --omit=dev \
  && npm install tsx@^4.21.0 --no-save \
  && npm cache clean --force

COPY examples/ ./examples/
COPY shared/ ./shared/
COPY start.js ./

# Seed config.json so the container has working defaults out of the box.
# Override at runtime by mounting your own ~/.ai-agent into /root/.ai-agent.
COPY config.example.json /root/.ai-agent/config.json

ENV NODE_ENV=production
ENV PORT=4567
EXPOSE 4567

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD node -e "require('http').get('http://127.0.0.1:'+(process.env.PORT||4567)+'/health',(r)=>process.exit(r.statusCode===200?0:1)).on('error',()=>process.exit(1))"

# Override the example via `docker run ... <image> 05-basic` etc.
CMD ["./node_modules/.bin/tsx", "start.js", "08-basic"]
