# syntax=docker/dockerfile:1
#
# TENANT image — thin layer on top of ai-agent-base that bakes ONE
# project's config (.ai-agent/) into the image. Rebuilding this image
# after a config change is a few seconds because every heavy layer
# lives in the base image.
#
# Usage from repo root:
#
#   1. Build the base image (slow — only when agent code changes):
#        docker build -f deploy/Dockerfile.agent-base -t ai-agent-base:latest .
#
#   2. Lay down your project config under `deploy/tenant-example/.ai-agent/`
#      (or copy that directory to your own deployment repo). At minimum it
#      should contain a `settings.json`. See `deploy/tenant-example/` for a
#      skeleton.
#
#   3. Build the tenant image:
#        docker build -f deploy/Dockerfile.agent.example \
#          --build-arg BASE_TAG=latest \
#          -t ai-agent-tenant:latest \
#          deploy/tenant-example
#
#   4. Run via compose (which already references ai-agent-tenant:latest):
#        docker compose -f deploy/docker-compose.yml up -d
#
# Secrets:
#   DO NOT commit API keys into settings.json — they will end up in image
#   layers and are recoverable via `docker history` even if a later layer
#   overwrites them.  Reference env vars in settings.json with ${VAR_NAME}
#   placeholders (if your config loader supports them) or pass them at
#   runtime via the agent process env and have the agent read them.
#   docker-compose.yml shows the env-injection pattern.

ARG BASE_TAG=latest
FROM 10.150.115.69:80/dice-zero/ai-agent-base:${BASE_TAG}

# UTF-8 locale — agent logs include CJK user text; a non-UTF-8 locale makes
# in-container shells/pagers (docker exec + less, etc.) show <E4><BD>… bytes.
ENV LANG=C.UTF-8 \
    LC_ALL=C.UTF-8

# ── Managed / policy (CC getManagedFilePath) → /etc/ai-agent ───────────────
# Settings: tenant models/MCP from repo .ai-agent/settings.json
COPY .ai-agent/settings.json /etc/ai-agent/managed-settings.json
# Extensions + AGENTS.md: only platform content from deploy/managed/
# (do NOT bake the whole project .ai-agent/skills into policy)
COPY deploy/managed/AGENTS.md /etc/ai-agent/AGENTS.md
COPY deploy/managed/.ai-agent/ /etc/ai-agent/.ai-agent/

# Per-user workspace template — copied on first SSO login into
# /workspace/users/<slug>/. User-visible agents/skills go here — not /etc.
COPY deploy/workspace-seed/ /opt/workspace-seed/

# Optional: override the default CMD from the base image.
# CMD ["./node_modules/.bin/tsx", "start.js"]
