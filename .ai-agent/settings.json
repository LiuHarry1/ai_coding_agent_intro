{
  "models": {
    "large": {
      "provider": "openai-compatible",
      "baseURL": "http://localhost:4141/v1",
      "apiKey": "not-needed",
      "model": "gpt-5.4"
    },
    "medium": {
      "provider": "openai-compatible",
      "baseURL": "http://localhost:4141/v1",
      "apiKey": "not-needed",
      "model": "gpt-4.1"
    },
    "small": {
      "provider": "openai-compatible",
      "baseURL": "http://localhost:4141/v1",
      "apiKey": "sk-xxx",
      "model": "gpt-4o-mini"
    }
  },
  "compaction": {
    "enabled": true,
    "contextWindow": 200000,
    "microCompactKeepRecent": 5,
    "maxFilesToRestore": 5,
    "maxTokensPerFile": 5000,
    "fileBudget": 50000,
    "timeBasedMicroEnabled": true,
    "timeBasedMicroGapMinutes": 5
  },
  "sessionMemory": {
    "enabled": true,
    "minimumTokensToInit": 10000,
    "minimumTokensBetweenUpdate": 5000,
    "toolCallsBetweenUpdates": 3,
    "cacheSafe": true,
    "modelTier": "small",
    "compactMinTokens": 10000,
    "compactMaxTokens": 40000,
    "compactMinTextMessages": 5
  },
  "autoMemory": {
    "enabled": true,
    "prefetchEnabled": true,
    "cacheSafe": true,
    "modelTier": "small",
    "prefetchModelTier": "small"
  },
  "lspServers": {
    "typescript": {
      "command": "npx",
      "args": ["--yes", "typescript-language-server", "--stdio"],
      "extensionToLanguage": {
        ".ts": "typescript",
        ".tsx": "typescriptreact"
      },
      "startupTimeout": 30000
    },
    "python": {
      "command": "npx",
      "args": ["--yes", "pyright-langserver", "--stdio"],
      "extensionToLanguage": {
        ".py": "python",
        ".pyi": "python"
      },
      "startupTimeout": 30000
    },
    "java-language-server": {
      "command": "npx",
      "args": ["--yes", "jj-language-server", "--stdio"],
      "extensionToLanguage": {
        ".java": "java"
      },
      "startupTimeout": 30000
    }



  },
  "mcpServers": {},

  "disabledTools": []
}
