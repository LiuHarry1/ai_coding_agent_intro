# Dependencies
node_modules/
client/web/node_modules/
client-sdk/node_modules/
protocol/node_modules/

# Environment & secrets
.env
.env.*
!.env.example

# Local agent / session state
.ai-agent/settings.local.json
.managed-demo/
# Legacy session dir (pre ~/.ai-agent/projects); ignore if leftover.
.sessions/
sessions/

# Frontend & desktop build outputs
client/web/dist/
dist/
dist-desktop/

# Source maps (generated by esbuild / bundlers)
*.cjs.map
*.js.map
*.mjs.map

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/

# Logs & temp
*.log
agent-stderr.log
*.tmp
*.temp

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Chrome extension pack output (private signing keys)
extension.crx
extension.pem
chrome-extension.crx
chrome-extension.pem
deploy
.ai-agent/

# Version the chart skill's deterministic generator and vendored runtime while
# keeping other local/deployment state ignored.
!.ai-agent/
.ai-agent/*
!.ai-agent/skills/
.ai-agent/skills/*
!.ai-agent/skills/echarts-chart/
!.ai-agent/skills/echarts-chart/**

!deploy/
deploy/*
!deploy/workspace-seed/
deploy/workspace-seed/*
!deploy/workspace-seed/.ai-agent/
deploy/workspace-seed/.ai-agent/*
!deploy/workspace-seed/.ai-agent/skills/
deploy/workspace-seed/.ai-agent/skills/*
!deploy/workspace-seed/.ai-agent/skills/echarts-chart/
!deploy/workspace-seed/.ai-agent/skills/echarts-chart/**
