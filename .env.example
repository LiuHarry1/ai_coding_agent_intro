# ---------------------------------------------------------------------------
# Example env file. Copy to `.env` and fill in real values.
# Loaded automatically by `start.js` via Node's built-in process.loadEnvFile.
# ---------------------------------------------------------------------------

# === Model provider keys =====================================================
# Pick whichever provider you actually use; the others can be left blank.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# === Server ==================================================================
# HTTP port for the SSE server.
PORT=3000

# === Workspace ===============================================================
# Default project root the agent operates on when a request doesn't pass
# `workspace`. Resolution priority at boot:
#   1. CLI flag:   node start.js 08-basic --workspace=/abs/path
#   2. This env:   WORKSPACE=/abs/path        (Docker-friendly default)
#   3. Fallback:   the directory the server was started from
#
# Boundary: writes (write_file / edit_file) MUST stay inside the workspace.
# Reads (bash / read_file) are unrestricted.
# WORKSPACE=

# === Ripgrep / Grep / Glob ===================================================
# Fallback behavior for the `rg` binary:
#   (unset)  : use system `rg` if present, fall back to pure-Node otherwise
#             (recommended).
#   force    : always use the pure-Node fallback, even if `rg` is installed.
#   off      : never use the fallback; throw RipgrepNotFoundError when `rg`
#              is missing.
RG_FALLBACK=

# Hard timeout for any single `rg` invocation, in seconds. Default: 20.
RG_TIMEOUT_SECONDS=20

# Glob tool defaults — these control what `glob`/`grep` see when listing
# files. Both default to "true".
#
# GLOB_NO_IGNORE=true     → do NOT respect .gitignore (good for finding
#                           build artifacts and untracked files).
# GLOB_NO_IGNORE=false    → respect .gitignore (skip ignored files).
GLOB_NO_IGNORE=true

# GLOB_HIDDEN=true        → include dotfiles/dotdirs.
# GLOB_HIDDEN=false       → skip them.
GLOB_HIDDEN=true

# === Auto-compaction =========================================================
# Disable proactive auto-compaction entirely (reactive compaction on 413 still
# fires). Set to 1 to disable.
# DISABLE_AUTO_COMPACT=0

# Override the model's context window (used to compute compact threshold).
# Default: 200000. Threshold = contextWindow - 20000 - 13000 (= 167K for 200K).
# COMPACT_CONTEXT_WINDOW=200000

# Number of most-recent tool results to keep verbatim during micro-compaction.
# COMPACT_MICRO_KEEP=5
