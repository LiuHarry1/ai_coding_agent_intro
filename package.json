{
  "name": "ai_coding_agent_test",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "start": "tsx start.js",
    "cli": "tsx start.js --stdio",
    "acp": "tsx start.js --acp",
    "dev:web": "npm --prefix client/web run dev",
    "build:web": "npm --prefix client/web run build",
    "build:worker": "node ./src/worker/build-worker.cjs",
    "desktop:start": "electron .",
    "desktop:dev": "npm run build:web && npm run desktop:start",
    "desktop:pack": "npm run build:web && electron-builder --config electron-builder.config.cjs",
    "desktop:pack:win": "npm run build:web && electron-builder --config electron-builder.config.cjs --win",
    "typecheck": "tsc --noEmit -p src/tsconfig.json && npm --prefix protocol run typecheck && npm --prefix client-sdk run typecheck",
    "browser:pair": "tsx src/scripts/browser-pair.ts",
    "browser:dev-chrome": "tsx src/scripts/browser-dev-chrome.ts",
    "test:browser:unit": "tsx src/scripts/test-browser-unit.ts",
    "test:browser:pw": "tsx src/scripts/test-browser-playwright.ts",
    "test:browser": "tsx src/scripts/test-browser-unit.ts && tsx src/scripts/test-browser-boundary.ts && tsx src/scripts/test-browser-live.ts && tsx src/scripts/test-browser-playwright.ts && tsx src/scripts/test-browser-relay.ts && tsx src/scripts/test-extension-e2e.ts",
    "format": "npx prettier --write \"src/**/*.ts\" \"protocol/src/**/*.ts\" \"client-sdk/**/*.ts\" \"client/web/src/**/*.{js,jsx}\" \"electron/**/*.mjs\" \"start.js\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.1.0",
    "@ai-sdk/anthropic": "^3.0.74",
    "@ai-sdk/mcp": "^1.0.36",
    "@ai-sdk/openai": "^3.0.52",
    "@ai-sdk/openai-compatible": "^2.0.35",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@mozilla/readability": "^0.6.0",
    "ai": "^6.0.116",
    "archiver": "^8.0.0",
    "axios": "^1.19.0",
    "glob": "^10.5.0",
    "gray-matter": "^4.0.3",
    "ignore": "^7.0.5",
    "linkedom": "^0.18.12",
    "lru-cache": "^11.5.2",
    "multer": "^2.1.1",
    "pdf-parse": "^1.1.4",
    "playwright-core": "^1.62.1",
    "sharp": "^0.33.5",
    "turndown": "^7.2.4",
    "vscode-jsonrpc": "^9.0.1",
    "vscode-languageserver-protocol": "^3.18.2",
    "vscode-languageserver-types": "^3.18.0",
    "ws": "^8.21.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/archiver": "^7.0.0",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.6.0",
    "@types/turndown": "^5.0.6",
    "@types/ws": "^8.18.1",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "prettier": "^3.5.3",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  }
}
