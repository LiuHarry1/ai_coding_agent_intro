{
  "name": "ai_coding_agent_test",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "start": "tsx start.js",
    "start:js": "node start.js",
    "server:stop": "node ./shared/kill-port.cjs 4567",
    "server:restart": "npm run server:stop && npm run start",
    "build:web": "npm --prefix client/web run build",
    "desktop:start": "electron .",
    "desktop:dev": "npm run build:web && npm run desktop:start",
    "desktop:pack": "npm run build:web && electron-builder",
    "desktop:pack:win": "npm run build:web && electron-builder --win",
    "typecheck": "tsc --noEmit -p examples/08-basic/tsconfig.json"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.74",
    "@ai-sdk/mcp": "^1.0.36",
    "@ai-sdk/openai": "^3.0.52",
    "@ai-sdk/openai-compatible": "^2.0.35",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@mozilla/readability": "^0.6.0",
    "ai": "^6.0.116",
    "archiver": "^8.0.0",
    "gray-matter": "^4.0.3",
    "ignore": "^7.0.5",
    "linkedom": "^0.18.12",
    "multer": "^2.1.1",
    "pdf-parse": "^1.1.4",
    "sharp": "^0.33.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/archiver": "^7.0.0",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.6.0",
    "electron": "^35.7.5",
    "electron-builder": "^25.1.8",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  },
  "build": {
    "appId": "com.baize.desktop",
    "productName": "Baize",
    "directories": {
      "output": "dist-desktop"
    },
    "files": [
      "electron/**/*",
      "start.js",
      "examples/**/*",
      "shared/**/*",
      "client/web/dist/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "asar": false,
    "win": {
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    }
  }
}
